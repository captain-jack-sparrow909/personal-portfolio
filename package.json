{
  "name": "jabir-khan-portfolio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "generate:model": "pnpm generate:model:raw && pnpm optimize:model",
    "generate:model:raw": "node scripts/generate-cognitive-engine.mjs",
    "optimize:model": "gltf-transform meshopt public/models/cognitive-engine.glb public/models/cognitive-engine.optimized.glb --level high && node scripts/audit-cognitive-engine.mjs public/models/cognitive-engine.optimized.glb && mv public/models/cognitive-engine.optimized.glb public/models/cognitive-engine.glb",
    "audit:model": "node scripts/audit-cognitive-engine.mjs",
    "audit:bundles": "node scripts/audit-bundles.mjs",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium-desktop --project=chromium-mobile",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.25",
    "next": "^16.1.6",
    "postprocessing": "^6.39.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwind-merge": "^3.3.1",
    "three": "^0.185.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.4.2",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.1.6",
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}

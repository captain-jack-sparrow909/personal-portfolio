# Public site origin used for canonical, sitemap and structured-data URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact delivery. Create a Resend API key and verify the sender domain before production.
RESEND_API_KEY=
CONTACT_EMAIL_FROM=Jabir Khan Portfolio <portfolio@your-verified-domain.com>
CONTACT_EMAIL_TO=khanjabir909@gmail.com

# Optional in-memory limiter settings. Use a durable shared limiter when deploying at scale.
CONTACT_RATE_LIMIT_MAX=5
CONTACT_RATE_LIMIT_WINDOW_MS=600000

# Optional privacy-friendly analytics. No analytics script loads when the domain is blank.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js
